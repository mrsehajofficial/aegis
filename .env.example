# Aegis — Telegram Group Management Bot
# Copy to .env via:  python -m app.setup   (recommended, never commit .env)
# Or manually:      cp .env.example .env

# Get from @BotFather on Telegram (NEVER commit the real value)
BOT_TOKEN=123456:REPLACE_ME

# SQLite for local dev (no server needed), Postgres for production
DATABASE_URL=sqlite+aiosqlite:///./aegis.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegis

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Your numeric Telegram user ID(s) from @userinfobot, comma-separated
SUPER_ADMIN_IDS=

# Display name used in bot replies (/start, /help, greetings)
BOT_NAME=Aegis

# Action when a user hits the warn limit: mute | ban | kick
WARN_ACTION=mute

# ── Optional: webhook delivery ────────────────────────────────────────────────
# Leave WEBHOOK_URL empty for long polling (default, no public URL needed).
# For production, point it at a public HTTPS origin; Telegram requires TLS on
# ports 443, 80, 88 or 8443 (terminate TLS with caddy/nginx and forward here).
# WEBHOOK_URL=https://bot.example.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_PORT=8443
# WEBHOOK_SECRET=            # auto-generated when empty
# HEALTH_PORT=8080           # GET /health — 0 disables the endpoint

# ── Optional: Redis-backed anti-flood ────────────────────────────────────────
# Set to share flood counters across workers and survive restarts
# (e.g. redis://redis:6379/0 with the bundled docker-compose).
# Empty = per-process memory (fine for a single instance).
# REDIS_URL=

# ── Captcha defaults (admins can override per group via /setcaptcha) ─────────
# CAPTCHA_TIMEOUT_SECONDS=120
# CAPTCHA_ACTION=kick        # kick | ban
