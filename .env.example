# Yuki — Telegram Group Management Bot
# Copy to .env via:  python -m app.setup   (recommended, never commit .env)
# Or manually:      cp .env.example .env

# Get from @BotFather on Telegram (NEVER commit the real value)
BOT_TOKEN=123456:REPLACE_ME

# SQLite for local dev (no server needed), Postgres for production
DATABASE_URL=sqlite+aiosqlite:///./aegis.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegis

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Your numeric Telegram user ID(s) from @userinfobot, comma-separated
SUPER_ADMIN_IDS=

# Display name used in bot replies (/start, /help, greetings)
BOT_NAME=Yuki

# Action when a user hits the warn limit: mute | ban | kick
WARN_ACTION=mute
